# Leave these unset and Nook runs entirely on the device — no accounts, no sync.
# Set them and it gets sign-in, boards that follow the account, and real invites.
#
# Both values are from your Supabase project: Settings → API.
# The anon key is meant to be public; row level security is what protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
